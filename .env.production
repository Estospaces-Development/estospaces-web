# GCP Production environment - same-origin via nginx proxy.
# Each service uses an unambiguous path prefix. Nginx strips the prefix and
# proxies to the correct Cloud Run backend. The browser only ever makes
# same-origin requests so connect-src 'self' CSP is satisfied.
# Switch to this locally with: npm run env:prod
VITE_CORE_SERVICE_URL=/__api/core
VITE_BOOKING_SERVICE_URL=/__api/booking
VITE_PAYMENT_SERVICE_URL=/__api/payment
VITE_NOTIFICATION_SERVICE_URL=/__api/notification
VITE_SEARCH_SERVICE_URL=/__api/search
VITE_MEDIA_SERVICE_URL=/__api/media
VITE_MESSAGING_SERVICE_URL=/__api/messaging
