{
  "name": "estospaces-web-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "node scripts/run-unit-tests.cjs",
    "test:fast-track": "tsx --test src/lib/apiUtils.test.ts src/lib/fastTrackWorkflow.test.ts src/lib/managerFastTrack.test.ts src/lib/userFastTrack.test.ts src/lib/fastTrackLinkedJourney.test.ts src/lib/fastTrackStageGuidance.test.ts src/lib/fastTrackProcessScenarios.test.ts",
    "test:e2e:dev": "node scripts/e2e-smoke.cjs --target=dev",
    "test:e2e:local": "node scripts/e2e-smoke.cjs --target=local",
    "test:e2e:all": "node scripts/e2e-smoke.cjs --target=dev --target=local",
    "test:e2e:batch:catalog": "node scripts/e2e-batch-catalog.cjs",
    "test:e2e:batch": "node scripts/e2e-batch-runner.cjs",
    "test:e2e:batch:dev": "node scripts/e2e-batch-runner.cjs --env=dev",
    "test:e2e:batch:local": "node scripts/e2e-batch-runner.cjs --env=local",
    "test:e2e:batch:review": "node scripts/e2e-batch-review.cjs",
    "env:local": "node -e \"require('fs').copyFileSync('.env.local-preset', '.env.development')\" && echo Switched to LOCAL backend",
    "env:dev": "node -e \"require('fs').copyFileSync('.env.gcp-dev', '.env.development')\" && echo Switched to GCP DEV backend"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.182.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.34.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.2.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "playwright": "^1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^6.1.1"
  }
}
