{
  "name": "estospaces-web-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.cjs",
    "test:fast-track": "tsx --test src/lib/apiUtils.test.ts src/lib/fastTrackWorkflow.test.ts src/lib/managerFastTrack.test.ts src/lib/userFastTrack.test.ts src/lib/fastTrackLinkedJourney.test.ts src/lib/fastTrackStageGuidance.test.ts src/lib/fastTrackProcessScenarios.test.ts",
    "test:e2e:dev": "node scripts/e2e-smoke.cjs --target=dev",
    "test:e2e:local": "node scripts/e2e-smoke.cjs --target=local",
    "test:e2e:all": "node scripts/e2e-smoke.cjs --target=dev --target=local",
    "test:e2e:batch:catalog": "node scripts/e2e-batch-catalog.cjs",
    "test:e2e:batch": "node scripts/e2e-batch-runner.cjs",
    "test:e2e:batch:dev": "node scripts/e2e-batch-runner.cjs --env=dev",
    "test:e2e:batch:local": "node scripts/e2e-batch-runner.cjs --env=local",
    "test:e2e:batch:staging": "node scripts/e2e-batch-runner.cjs --env=staging",
    "test:e2e:batch:prod": "node scripts/e2e-batch-runner.cjs --env=prod",
    "test:e2e:batch:review": "node scripts/e2e-batch-review.cjs",
    "test:release-smoke:staging": "node scripts/app-release-smoke.cjs --target=staging",
    "test:release-smoke:prod": "node scripts/app-release-smoke.cjs --target=prod",
    "test:messages:local": "node scripts/messages-proof.cjs --target=local",
    "test:messages:dev": "node scripts/messages-proof.cjs --target=dev",
    "test:support:local": "node scripts/support-lifecycle-proof.cjs --target=local",
    "test:support:dev": "node scripts/support-lifecycle-proof.cjs --target=dev",
    "test:research:local": "node scripts/admin-research-proof.cjs --target=local",
    "test:research:dev": "node scripts/admin-research-proof.cjs --target=dev",
    "test:public:local": "node scripts/public-proof.cjs --target=local",
    "test:public:dev": "node scripts/public-proof.cjs --target=dev",
    "test:platform:local": "node scripts/full-platform-proof.cjs --target=local",
    "test:platform:dev": "node scripts/full-platform-proof.cjs --target=dev",
    "test:platform:extra:local": "node scripts/platform-extra-proof.cjs --target=local",
    "test:platform:extra:dev": "node scripts/platform-extra-proof.cjs --target=dev",
    "env:local": "node -e \"require('fs').copyFileSync('.env.local-preset', '.env.development')\" && echo Switched to LOCAL backend",
    "env:dev": "node -e \"require('fs').copyFileSync('.env.gcp-dev', '.env.development')\" && echo Switched to GCP DEV backend",
    "env:staging": "node -e \"require('fs').copyFileSync('.env.staging', '.env.development')\" && echo Switched to STAGING backend",
    "env:prod": "node -e \"require('fs').copyFileSync('.env.production', '.env.development')\" && echo Switched to PRODUCTION backend",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.182.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.34.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "uuid": "^14.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "5.2.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^6.1.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.23",
    "follow-redirects": "^1.16.0",
    "minimatch": "^3.1.5"
  }
}
